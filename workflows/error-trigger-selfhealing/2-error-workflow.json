{
  "name": "Error Workflow (обработка ошибок)",
  "nodes": [
    {
      "id": "55e4187b-d88b-448b-870f-c122af33781b",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        288
      ]
    },
    {
      "id": "d31fbaaa-c69b-4ced-a6ed-505a43917d52",
      "name": "Собрать данные ошибки",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "time",
              "value": "={{ $now.format(\"yyyy-MM-dd HH:mm:ss\") }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "workflowName",
              "value": "={{ $json.workflow.name }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "stackTrace",
              "value": "={{ $json.execution.error.stack }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "errorOutput",
              "value": "={{ JSON.stringify($json, null, 2) }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "5c64a7bd-1ee6-457f-bd05-d8786a011772",
      "name": "Запись в лог (Google Docs)",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "document",
        "operation": "update",
        "authentication": "oAuth2",
        "documentURL": "YOUR_GOOGLE_DOC_URL",
        "actionsUi": {
          "actionFields": [
            {
              "object": "text",
              "action": "insert",
              "locationChoice": "endOfSegmentLocation",
              "text": "=\n[{{ $json.time }}] {{ $json.workflowName }}\n{{ $json.errorOutput }}\n"
            }
          ]
        }
      }
    },
    {
      "id": "3282c800-a32f-4968-a189-b796d2a76c23",
      "name": "Анализатор логов (GPT)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        192
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-nano",
          "cachedResultName": "gpt-4.1-nano"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "system",
              "content": "Ты анализатор логов n8n. Пишешь по-русски. Опиши проблему кратко, в трёх предложениях."
            },
            {
              "type": "text",
              "role": "user",
              "content": "=Workflow: {{ $json.workflowName }}\nСтек ошибки: {{ $json.stackTrace }}"
            }
          ]
        },
        "simplify": true
      }
    },
    {
      "id": "df472f76-8cee-4d2d-82c3-2a87ba2b677b",
      "name": "Собрать алерт",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "tgMessage",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "errorOutput",
              "value": "={{ $(\"Собрать данные ошибки\").item.json.errorOutput }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "ec4ab8b0-fd3f-4bd9-8ef1-e2fc9c23b264",
      "name": "JSON ошибки в файл",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        896,
        192
      ],
      "parameters": {
        "operation": "toText",
        "sourceProperty": "errorOutput",
        "binaryPropertyName": "data"
      }
    },
    {
      "id": "ad6b8485-8d4e-4c88-a192-fd509887cf56",
      "name": "Алерт в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendDocument",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "={{ $(\"Собрать алерт\").item.json.tgMessage }}"
        }
      }
    },
    {
      "id": "0d7ce272-0a11-49f8-a147-b26200c9c796",
      "name": "Запустить резервный сценарий",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        448,
        384
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "← выберите импортированный «Execute Error Workflow»"
        },
        "mode": "once"
      }
    },
    {
      "id": "08709d31-9013-4afb-aac9-23ac38795263",
      "name": "Отправить ошибку AI-агенту",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        576
      ],
      "parameters": {
        "method": "POST",
        "url": "https://your-self-healing-server.example.com/webhook/error",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $(\"Собрать данные ошибки\").item.json.errorOutput }}"
      }
    },
    {
      "id": "s-err-1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        120
      ],
      "parameters": {
        "content": "## Error Workflow — обработка ошибок\n**Error Trigger** ловит падение любого workflow, где в Settings указан этот сценарий.\nДальше данные нормализуются в Set и расходятся на 4 ветки →",
        "height": 150,
        "width": 420,
        "color": 4
      }
    },
    {
      "id": "s-err-2",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        420,
        -160
      ],
      "parameters": {
        "content": "## Ветка 1 — лог\nПишем ошибку в **Google Docs** (можно заменить на БД, Grafana, S3). Привяжи свои Google-креды и URL документа.",
        "height": 130,
        "width": 320,
        "color": 3
      }
    },
    {
      "id": "s-err-3",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        620,
        40
      ],
      "parameters": {
        "content": "## Ветка 2 — алерт\nНейронка описывает проблему по-русски → в Telegram уходит **текст (caption) + файл со всем JSON**.\n⚠️ Set стоит перед Convert to File специально: нода читает только предыдущую ноду.",
        "height": 120,
        "width": 700,
        "color": 6
      }
    },
    {
      "id": "s-err-4",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        360,
        470
      ],
      "parameters": {
        "content": "## Ветка 3 — резерв\n**Execute Sub-workflow** дёргает второй триггер генератора и берёт данные с запасного сервера.",
        "height": 90,
        "width": 340,
        "color": 5
      }
    },
    {
      "id": "s-err-5",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        360,
        660
      ],
      "parameters": {
        "content": "## Ветка 4 — самолечение\nPOST отдаёт JSON ошибки внешнему **AI-агенту**, который через n8n MCP чинит инстанс (в демо — меняет битый адрес в HTTP-ноде). Сам сервер-агент — отдельная программа (см. README).",
        "height": 120,
        "width": 380,
        "color": 2
      }
    }
  ],
  "connections": {
